# Brewfile—Homebrew dependencies for cgatno/dotfiles
# Install everything with: brew bundle

# Build Toolchain and Dependencies
brew "gcc"
brew "xz"
brew "libxt"
brew "cairo"
brew "pcre2"
brew "pkg-config"

# Configuration management
brew "chezmoi"

# Shell & prompt
brew "fish"
brew "starship"

# Multiplexer & history
brew "tmux"
brew "atuin"

# Editor & dev tooling
brew "neovim"
brew "mise"

# Modern CLI replacements
brew "eza"        # ls
brew "zoxide"     # cd
brew "fzf"        # fuzzy finder
brew "bat"        # cat
brew "ripgrep"    # grep
brew "fd"         # find
brew "git-delta"  # better diff renderer

# Pre-commit secret scanning
brew "gitleaks"
brew "pre-commit"

# GUI & fonts
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
