# ============================================================
# chezmoi ignore—patterns that should never be managed
# (this file is always rendered as a chezmoi template)
# ============================================================

{{- if ne .chezmoi.os "darwin" }}
# ----- macOS-only apps (skip everywhere else) -----
# Ghostty is a native macOS terminal; on Linux/WSL the terminal lives
# outside this repo (e.g. Windows Terminal), so don't manage its config.
.config/ghostty/**
{{- end }}

# ----- Fish auto-managed / Fisher-installed files -----
# These are regenerated when Fisher installs plugins on a fresh machine
.config/fish/fish_variables
.config/fish/conf.d/*
.config/fish/completions/*
.config/fish/functions/__*
.config/fish/functions/_*
.config/fish/functions/fisher.fish
.config/fish/functions/bass.fish
.config/fish/functions/g*.fish
.config/fish/functions/grt.fish
.config/fish/functions/glp.fish

# Re-include our hand-written function explicitly
!.config/fish/functions/devupdate.fish

# ----- Zed auto-managed state -----
# Only settings.json is hand-written; Zed owns everything else in this
# directory (agent threads, the LMDB prompt library, downloaded themes).
.config/zed/conversations/**
.config/zed/prompts/**
.config/zed/themes/**

# Zed writes {settings,keymap}_backup.json itself whenever it migrates a
# deprecated key—a stale copy of the real config, never worth committing.
.config/zed/*_backup.json

# ----- macOS noise -----
.DS_Store
**/.DS_Store

# ----- Editor / cache noise -----
.config/nvim/.netrwhist
.local/share/nvim/
.cache/

# ----- Atuin history database (private) -----
.local/share/atuin/

# ----- TPM-installed tmux plugins -----
.tmux/plugins/

# ----- Secrets / credentials (defensive—should never be added) -----
.config/atuin/key
.config/atuin/session
.config/gh/hosts.yml
.config/github-copilot/
.config/configstore/
.ssh/
.gnupg/
.aws/credentials
.docker/config.json
.npmrc
.netrc

# ----- Env / dotenv files -----
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# ----- Common credential filenames -----
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# ----- README, license, and other repo meta -----
# (these live in the repo but shouldn't be applied to ~)
readme.md
LICENSE
Brewfile
assets
.pre-commit-config.yaml
.gitignore
