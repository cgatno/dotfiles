{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Install CLI dependencies on Linux/WSL—the apt + binaries counterpart
# to the macOS Brewfile. Re-runs whenever Brewfile changes, so the two
# stay conceptually in sync.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -eu

LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"

# ----- apt packages (Debian/Ubuntu) -----
# Install a package only when the binary it provides is missing.
if command -v apt-get >/dev/null 2>&1; then
    missing=""
    for pair in \
        fish:fish \
        tmux:tmux \
        fzf:fzf \
        ripgrep:rg \
        bat:batcat \
        fd-find:fdfind \
        zoxide:zoxide \
        eza:eza \
        git-delta:delta \
        pre-commit:pre-commit
    do
        pkg=${pair%%:*}
        bin=${pair##*:}
        command -v "$bin" >/dev/null 2>&1 || missing="$missing $pkg"
    done
    if [ -n "$missing" ]; then
        echo "==> apt installing:$missing"
        sudo apt-get update -qq
        # shellcheck disable=SC2086
        sudo apt-get install -y $missing
    fi
fi

# Ubuntu/Debian ship bat as `batcat` and fd as `fdfind`. Expose the
# conventional names that the fish config and fzf.fish expect.
if command -v batcat >/dev/null 2>&1 && [ ! -e "$LOCAL_BIN/bat" ]; then
    ln -s "$(command -v batcat)" "$LOCAL_BIN/bat"
fi
if command -v fdfind >/dev/null 2>&1 && [ ! -e "$LOCAL_BIN/fd" ]; then
    ln -s "$(command -v fdfind)" "$LOCAL_BIN/fd"
fi

# ----- tools not packaged in apt: install prebuilt binaries -----
# These land in ~/.local/bin (already on PATH), independent of mise, so
# they resolve during fish startup before `mise activate` runs.
case "$(uname -m)" in
    x86_64|amd64)  atuin_arch=x86_64;  gl_arch=x64 ;;
    aarch64|arm64) atuin_arch=aarch64; gl_arch=arm64 ;;
    *) atuin_arch=""; gl_arch=""; echo "Unsupported arch $(uname -m); skipping starship/atuin/gitleaks." >&2 ;;
esac

# starship—official installer ships a prebuilt binary.
if ! command -v starship >/dev/null 2>&1; then
    echo "==> Installing starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$LOCAL_BIN"
fi

# atuin—versionless 'latest' release asset.
if [ -n "$atuin_arch" ] && ! command -v atuin >/dev/null 2>&1; then
    echo "==> Installing atuin..."
    curl -fsSL "https://github.com/atuinsh/atuin/releases/latest/download/atuin-${atuin_arch}-unknown-linux-gnu.tar.gz" \
        | tar -xz --strip-components=1 --wildcards -C "$LOCAL_BIN" '*/atuin'
fi

# gitleaks—release assets are version-stamped, so resolve latest first.
# Only needed for the pre-commit hook when committing to this repo.
if [ -n "$gl_arch" ] && ! command -v gitleaks >/dev/null 2>&1; then
    echo "==> Installing gitleaks..."
    gl_ver=$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest \
        | grep -m1 '"tag_name"' | cut -d'"' -f4 | sed 's/^v//')
    if [ -n "$gl_ver" ]; then
        curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${gl_ver}/gitleaks_${gl_ver}_linux_${gl_arch}.tar.gz" \
            | tar -xz -C "$LOCAL_BIN" gitleaks
    fi
fi
{{- end -}}
