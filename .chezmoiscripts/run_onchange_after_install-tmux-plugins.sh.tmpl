#!/bin/sh
# Install Tom's tmux plugin manager (TPM) and sync tmux plugins.
# Re-runs whenever .tmux.conf changes (so adding a plugin auto-installs it).
#
# tmux.conf hash: {{ include "dot_tmux.conf" | sha256sum }}

set -eu

TPM_DIR="$HOME/.tmux/plugins/tpm"

if [ ! -d "$TPM_DIR" ]; then
    echo "==> Cloning TPM..."
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "Skipping tmux plugin install: tmux is not installed." >&2
    exit 0
fi

echo "==> Installing tmux plugins..."
"$TPM_DIR/bin/install_plugins"
