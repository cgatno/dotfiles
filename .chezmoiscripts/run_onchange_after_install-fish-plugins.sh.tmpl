#!/bin/sh
# Bootstrap Fisher and sync plugins from fish_plugins.
# Re-runs whenever fish_plugins changes.
#
# fish_plugins hash: {{ include "private_dot_config/private_fish/fish_plugins" | sha256sum }}

set -eu

if ! command -v fish >/dev/null 2>&1; then
    echo "Skipping Fisher bootstrap: fish is not installed." >&2
    exit 0
fi

# Bootstrap Fisher itself if it's not yet a fish function.
if ! fish -c 'functions -q fisher' 2>/dev/null; then
    echo "==> Bootstrapping Fisher..."
    fish -c '
        curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
        fisher install jorgebucaran/fisher
    '
fi

echo "==> Syncing Fisher plugins from fish_plugins..."
fish -c 'fisher update'
