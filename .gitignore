# ============================================================
# .gitignore — last line of defense against committing secrets
# (chezmoi's own ignore is .chezmoiignore; this one is for git)
# ============================================================

# ----- Secrets / credentials -----
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
authorized_keys
.netrc
.npmrc
*credentials*
*secret*

# ----- Env files (keep examples) -----
.env
.env.*
!.env.example
!.env.sample

# ----- OS / editor noise -----
.DS_Store
*.swp
*.swo
*~

# ----- chezmoi local state -----
.chezmoistate
