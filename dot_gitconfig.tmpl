[user]
	name = Christian Gaetano
	email = hello@christiangaetano.com

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = gruvbox-dark

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
{{- if eq .chezmoi.os "linux" }}

# On Linux/WSL, authenticate git over HTTPS through the GitHub CLI.
# (macOS uses the osxkeychain helper that ships with Apple git.)
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
